__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# data/events.db and config/profile.json ARE tracked in git (see README's
# "Background cadence" section): this runs in an ephemeral container that
# can be reclaimed between sessions, so committing them is the persistence
# mechanism for a private personal repo. Swap this for a real hosted DB if
# this ever moves off a single private repo.
data/*.db-journal

# Regenerable export artifacts (like a roundup file) — derived from
# events.db on demand, not a source of truth, so not worth tracking.
data/snapshot.json
data/*roundup*
data/ingest.log

# Flask session-signing secret. Unlike events.db/profile.json this is a
# real security secret — leaking it lets someone forge login sessions.
# Generated locally on first `events web run`; never committed.
data/flask_secret.key
